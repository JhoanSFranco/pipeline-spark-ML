# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Spark generated event logs and streaming checkpoints
# Keep the empty spark-logs/ folder in the repo: if it is missing, Docker
# creates it as root and later `git pull` fails with "Permission denied"
spark-logs/*
!spark-logs/.gitkeep
**/checkpoint_*/
**/checkpoints/
**/checkpoint_*/**/*.tmp
**/.metadata.crc
**/*.crc
**/spark-logs/**/*.inprogress
**/spark-logs/**/*.zstd

# Runtime and application logs
*.log
logs/
**/logs/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Docker local overrides and generated archives
docker-compose.override.yml
*.tar
*.tar.gz
*.docker.tar

# Editors and operating systems
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

*.zip
docs/airbnb_paris_project_plan.md

# Data: the raw Inside Airbnb file is too large for GitHub (180 MB > 100 MB limit)
data/raw/*
!data/raw/.gitkeep

# Spark local files
spark-warehouse/
metastore_db/
derby.log
